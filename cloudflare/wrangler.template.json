{
  "name": "kitwise-company-os",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "17 7 * * *",
      "*/15 * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "ASSET_KV",
      "id": "ba4970bd220b4e2b9fd00ce934de4ef8"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "WORKERS_PLAN": "free",
    "PRODUCTION_ENABLED": "true",
    "ASSET_STORAGE_FREE_CONFIRMED": "true",
    "VISION_MODEL_VERIFIED": "true",
    "IMAGES_FREE_CONFIRMED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitwise-company-os",
      "database_id": "REPLACED_AT_DEPLOYMENT",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
